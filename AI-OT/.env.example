# Copy this file to .env and adjust as needed.
# SQLite is the default local development option so Docker is not required.
POSTGRES_DB=aiot
POSTGRES_USER=aiot_user
POSTGRES_PASSWORD=aiot_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=sqlite:///./aiot_dev.db
ENVIRONMENT=development
# Generate a unique value for each environment; never commit the completed .env file.
JWT_SECRET_KEY=<generate-a-long-random-secret>
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# Used only to create local synthetic demo accounts; it is never stored in the database.
DEMO_SEED_PASSWORD=123456
FRONTEND_ORIGIN=http://localhost:5173
# Optional external AI provider configuration. If omitted, the app uses a local, safe fallback.
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
